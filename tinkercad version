#include <LiquidCrystal.h>

// LCD pins: RS, E, D4, D5, D6, D7
LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

#define TEMP_PIN A1
#define HUMIDITY_PIN A0

void setup() {
  lcd.begin(16, 2);

  lcd.setCursor(0, 0);
  lcd.print("Greenhouse");
  lcd.setCursor(0, 1);
  lcd.print("Env Monitor");
  delay(2000);

  lcd.clear();
}

void loop() {

  // ----- Temperature -----
  int tempRaw = analogRead(TEMP_PIN);

  float voltage = tempRaw * (5.0 / 1023.0);

  float tempC = (voltage - 0.5) * 100;

  // ----- Humidity -----
  int humRaw = analogRead(HUMIDITY_PIN);

  int humidity = map(humRaw, 0, 1023, 0, 100);

  // ----- LCD Display -----
  lcd.setCursor(0, 0);

  lcd.print("T:");
  lcd.print(tempC, 1);
  lcd.print((char)223);
  lcd.print("C ");

  lcd.print("H:");
  lcd.print(humidity);
  lcd.print("% ");

  lcd.setCursor(0, 1);
  lcd.print("Monitoring... ");

  delay(500);
}
