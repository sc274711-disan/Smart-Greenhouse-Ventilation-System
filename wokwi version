#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <DHT.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

#define DHTPIN 7
#define DHTTYPE DHT22
#define VENT_PIN 9

DHT dht(DHTPIN, DHTTYPE);

void setup() {
  lcd.init();
  lcd.backlight();

  dht.begin();

  pinMode(VENT_PIN, OUTPUT);

  lcd.setCursor(0,0);
  lcd.print("Greenhouse");
  lcd.setCursor(0,1);
  lcd.print("Ventilation");
  delay(2000);

  lcd.clear();
}

void loop() {
  float temp = dht.readTemperature();
  float hum = dht.readHumidity();

  if (isnan(temp) || isnan(hum)) {
    lcd.setCursor(0,0);
    lcd.print("Sensor Error");
    return;
  }

  bool ventilation = false;

  if (temp >= 30 || hum >= 70) {
    ventilation = true;
  }

  digitalWrite(VENT_PIN, ventilation);

  lcd.setCursor(0,0);
  lcd.print("T:");
  lcd.print(temp,1);
  lcd.print((char)223);
  lcd.print("C ");

  lcd.print("H:");
  lcd.print(hum,0);
  lcd.print("% ");

  lcd.setCursor(0,1);

  if (ventilation) {
    lcd.print("Vent: ACTIVE ");
  } else {
    lcd.print("Vent: NORMAL ");
  }

  delay(1000);
}
